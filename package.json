{
  "name": "claude-switcher",
  "displayName": "Claude Account Switcher",
  "description": "Troca a conta do Claude Code com um clique e avisa quando uma conta esgotada volta.",
  "version": "0.3.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "vscode:uninstall": "node ./src/hook/uninstall.js",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && npx --yes @vscode/vsce package --allow-missing-repository --out dist/"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSwitcher",
          "title": "Claude Switcher",
          "icon": "media/switcher.svg"
        }
      ]
    },
    "views": {
      "claudeSwitcher": [
        {
          "id": "claudeSwitcher.accounts",
          "name": "Contas",
          "icon": "media/switcher.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeSwitcher.accounts",
        "contents": "Nenhuma conta salva ainda.\n[Adicionar conta](command:claudeSwitcher.addAccount)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeSwitcher.switchNext",
          "when": "view == claudeSwitcher.accounts",
          "group": "navigation@1"
        },
        {
          "command": "claudeSwitcher.addAccount",
          "when": "view == claudeSwitcher.accounts",
          "group": "navigation@2"
        },
        {
          "command": "claudeSwitcher.refresh",
          "when": "view == claudeSwitcher.accounts",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeSwitcher.useAccount",
          "when": "view == claudeSwitcher.accounts && viewItem =~ /^(account|advice)$/",
          "group": "inline@1"
        },
        {
          "command": "claudeSwitcher.renameAccount",
          "when": "view == claudeSwitcher.accounts && viewItem =~ /^account/",
          "group": "inline@2"
        },
        {
          "command": "claudeSwitcher.removeAccount",
          "when": "view == claudeSwitcher.accounts && viewItem =~ /^account/",
          "group": "inline@3"
        },
        {
          "command": "claudeSwitcher.useAccount",
          "when": "view == claudeSwitcher.accounts && viewItem == account",
          "group": "1_account@1"
        },
        {
          "command": "claudeSwitcher.renameAccount",
          "when": "view == claudeSwitcher.accounts && viewItem =~ /^account/",
          "group": "1_account@2"
        },
        {
          "command": "claudeSwitcher.removeAccount",
          "when": "view == claudeSwitcher.accounts && viewItem =~ /^account/",
          "group": "1_account@3"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeSwitcher.useAccount",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.renameAccount",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.removeAccount",
          "when": "false"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeSwitcher.useAccount",
        "title": "Usar esta conta",
        "category": "Claude Switcher",
        "icon": "$(arrow-right)"
      },
      {
        "command": "claudeSwitcher.renameAccount",
        "title": "Renomear",
        "category": "Claude Switcher",
        "icon": "$(edit)"
      },
      {
        "command": "claudeSwitcher.removeAccount",
        "title": "Remover do switcher",
        "category": "Claude Switcher",
        "icon": "$(trash)"
      },
      {
        "command": "claudeSwitcher.menu",
        "title": "Contas",
        "category": "Claude Switcher",
        "icon": "$(account)"
      },
      {
        "command": "claudeSwitcher.switchNext",
        "title": "Trocar para a próxima conta disponível",
        "category": "Claude Switcher",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "claudeSwitcher.addAccount",
        "title": "Adicionar conta",
        "category": "Claude Switcher",
        "icon": "$(add)"
      },
      {
        "command": "claudeSwitcher.refresh",
        "title": "Atualizar uso",
        "category": "Claude Switcher",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSwitcher.toggleAutoSwitch",
        "title": "Ligar/desligar o autoswitcher",
        "category": "Claude Switcher",
        "icon": "$(sync)"
      }
    ],
    "configuration": {
      "title": "Claude Switcher",
      "properties": {
        "claudeSwitcher.pollIntervalMinutes": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "De quantos em quantos minutos consultar o uso da conta em uso. As outras contas são consultadas a cada 15 minutos e na hora em que o limite delas zera."
        },
        "claudeSwitcher.autoSwitch": {
          "type": "boolean",
          "default": false,
          "description": "Autoswitcher: quando a conta em uso esgota, troca sozinho para a próxima disponível e faz o Claude Code continuar a tarefa, sem precisar digitar \"continue\". Instala um hook StopFailure em ~/.claude/settings.json (precisa do Node.js) e o remove ao desligar."
        },
        "claudeSwitcher.notifyWhenBack": {
          "type": "boolean",
          "default": true,
          "description": "Avisar quando uma conta esgotada voltar a ficar disponível."
        },
        "claudeSwitcher.burnWindowHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "description": "Marca a conta com 🔥 (e avisa) quando faltam até estas horas para a semana dela renovar e ainda sobra uso. Também marca antes disso quando sobra mais do que dá para gastar até a renovação."
        },
        "claudeSwitcher.notifyBurn": {
          "type": "boolean",
          "default": true,
          "description": "Avisar quando a conta recomendada não é a que está em uso e tem uso prestes a vencer."
        },
        "claudeSwitcher.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar a conta em uso também na barra de status (lado esquerdo)."
        }
      }
    }
  }
}
