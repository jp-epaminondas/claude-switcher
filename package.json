{
  "name": "claude-switcher",
  "displayName": "Claude Account Switcher",
  "description": "Troca a conta do Claude Code com um clique, avisa quando uma conta esgotada volta e junta no CLAUDE.md as preferências repetidas nos projetos.",
  "version": "0.9.4",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "vscode:uninstall": "node ./src/hook/uninstall.js",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && npx --yes @vscode/vsce package --allow-missing-repository --out dist/"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSwitcher",
          "title": "Claude Switcher",
          "icon": "media/switcher.svg"
        }
      ]
    },
    "views": {
      "claudeSwitcher": [
        {
          "id": "claudeSwitcher.accounts",
          "name": "Contas",
          "icon": "media/switcher.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeSwitcher.accounts",
        "contents": "Nenhuma conta salva ainda.\n[Adicionar conta](command:claudeSwitcher.addAccount)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeSwitcher.showAccounts",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page != accounts",
          "group": "0_pages@1"
        },
        {
          "command": "claudeSwitcher.showAccountsCurrent",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == accounts",
          "group": "0_pages@1"
        },
        {
          "command": "claudeSwitcher.showMemories",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page != memories",
          "group": "0_pages@2"
        },
        {
          "command": "claudeSwitcher.showMemoriesCurrent",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == memories",
          "group": "0_pages@2"
        },
        {
          "command": "claudeSwitcher.showCredentials",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page != credentials",
          "group": "0_pages@3"
        },
        {
          "command": "claudeSwitcher.showCredentialsCurrent",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials",
          "group": "0_pages@3"
        },
        {
          "command": "claudeSwitcher.addAccount",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == accounts",
          "group": "navigation@2"
        },
        {
          "command": "claudeSwitcher.refresh",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == accounts",
          "group": "navigation@3"
        },
        {
          "command": "claudeSwitcher.memories.openClaudeMd",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == memories",
          "group": "navigation@1"
        },
        {
          "command": "claudeSwitcher.memories.analyze",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == memories",
          "group": "navigation@2"
        },
        {
          "command": "claudeSwitcher.cred.addEntry",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && claudeSwitcher.vaultExists",
          "group": "navigation@1"
        },
        {
          "command": "claudeSwitcher.cred.import",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && claudeSwitcher.vaultExists",
          "group": "navigation@2"
        },
        {
          "command": "claudeSwitcher.cred.lock",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && claudeSwitcher.vaultUnlocked",
          "group": "navigation@3"
        },
        {
          "command": "claudeSwitcher.cred.unlock",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && claudeSwitcher.vaultExists && !claudeSwitcher.vaultUnlocked",
          "group": "navigation@3"
        },
        {
          "command": "claudeSwitcher.cred.changeMaster",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && claudeSwitcher.vaultExists",
          "group": "1_vault@1"
        },
        {
          "command": "claudeSwitcher.memories.addInstruction",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == memories",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeSwitcher.renameAccount",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == accounts && viewItem =~ /^account/",
          "group": "inline@1"
        },
        {
          "command": "claudeSwitcher.removeAccount",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == accounts && viewItem =~ /^account/",
          "group": "inline@2"
        },
        {
          "command": "claudeSwitcher.useAccount",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == accounts && viewItem == account",
          "group": "1_account@1"
        },
        {
          "command": "claudeSwitcher.renameAccount",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == accounts && viewItem =~ /^account/",
          "group": "1_account@2"
        },
        {
          "command": "claudeSwitcher.removeAccount",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == accounts && viewItem =~ /^account/",
          "group": "1_account@3"
        },
        {
          "command": "claudeSwitcher.memories.merge",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == memories && viewItem == suggestion",
          "group": "inline@1"
        },
        {
          "command": "claudeSwitcher.memories.ignore",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == memories && viewItem == suggestion",
          "group": "inline@2"
        },
        {
          "command": "claudeSwitcher.memories.merge",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == memories && viewItem == suggestion",
          "group": "1_memory@1"
        },
        {
          "command": "claudeSwitcher.memories.ignore",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == memories && viewItem == suggestion",
          "group": "1_memory@2"
        },
        {
          "command": "claudeSwitcher.memories.remove",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == memories && viewItem == claudeBlock",
          "group": "inline@1"
        },
        {
          "command": "claudeSwitcher.memories.remove",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == memories && viewItem == claudeBlock",
          "group": "1_memory@1"
        },
        {
          "command": "claudeSwitcher.memories.openClaudeMd",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == memories && viewItem == claudeMdRoot",
          "group": "inline@1"
        },
        {
          "command": "claudeSwitcher.cred.addField",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem == credEntry",
          "group": "inline@1"
        },
        {
          "command": "claudeSwitcher.cred.renameEntry",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem == credEntry",
          "group": "inline@2"
        },
        {
          "command": "claudeSwitcher.cred.removeEntry",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem == credEntry",
          "group": "inline@3"
        },
        {
          "command": "claudeSwitcher.cred.addField",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem == credEntry",
          "group": "1_cred@1"
        },
        {
          "command": "claudeSwitcher.cred.renameEntry",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem == credEntry",
          "group": "1_cred@2"
        },
        {
          "command": "claudeSwitcher.cred.removeEntry",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem == credEntry",
          "group": "1_cred@3"
        },
        {
          "command": "claudeSwitcher.cred.copy",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem =~ /^credField/",
          "group": "inline@1"
        },
        {
          "command": "claudeSwitcher.cred.editField",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem =~ /^credField/",
          "group": "inline@2"
        },
        {
          "command": "claudeSwitcher.cred.removeField",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem =~ /^credField/",
          "group": "inline@3"
        },
        {
          "command": "claudeSwitcher.cred.copy",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem =~ /^credField/",
          "group": "1_cred@1"
        },
        {
          "command": "claudeSwitcher.cred.copyRef",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem =~ /^credField/",
          "group": "1_cred@2"
        },
        {
          "command": "claudeSwitcher.cred.editField",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem =~ /^credField/",
          "group": "1_cred@3"
        },
        {
          "command": "claudeSwitcher.cred.renameField",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem =~ /^credField/",
          "group": "1_cred@4"
        },
        {
          "command": "claudeSwitcher.cred.toggleSecret",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem =~ /^credField/",
          "group": "1_cred@5"
        },
        {
          "command": "claudeSwitcher.cred.removeField",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem =~ /^credField/",
          "group": "1_cred@6"
        },
        {
          "command": "claudeSwitcher.cred.reveal",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem == credFieldSecret",
          "group": "inline@0"
        },
        {
          "command": "claudeSwitcher.cred.hide",
          "when": "view == claudeSwitcher.accounts && claudeSwitcher.page == credentials && viewItem == credFieldSecret.revealed",
          "group": "inline@0"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeSwitcher.useAccount",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.renameAccount",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.removeAccount",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.memories.merge",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.memories.ignore",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.memories.remove",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.memories.clearIgnored",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.showAccountsCurrent",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.showMemoriesCurrent",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.showCredentialsCurrent",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.cred.addField",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.cred.editField",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.cred.renameEntry",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.cred.renameField",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.cred.toggleSecret",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.cred.removeEntry",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.cred.removeField",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.cred.copy",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.cred.copyRef",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.cred.reveal",
          "when": "false"
        },
        {
          "command": "claudeSwitcher.cred.hide",
          "when": "false"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeSwitcher.useAccount",
        "title": "Usar esta conta",
        "category": "Claude Switcher",
        "icon": "$(arrow-right)"
      },
      {
        "command": "claudeSwitcher.renameAccount",
        "title": "Renomear",
        "category": "Claude Switcher",
        "icon": "$(edit)"
      },
      {
        "command": "claudeSwitcher.removeAccount",
        "title": "Remover do switcher",
        "category": "Claude Switcher",
        "icon": "$(trash)"
      },
      {
        "command": "claudeSwitcher.menu",
        "title": "Contas",
        "category": "Claude Switcher",
        "icon": "$(account)"
      },
      {
        "command": "claudeSwitcher.switchNext",
        "title": "Trocar para a próxima conta disponível",
        "category": "Claude Switcher",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "claudeSwitcher.addAccount",
        "title": "Adicionar conta",
        "category": "Claude Switcher",
        "icon": "$(add)"
      },
      {
        "command": "claudeSwitcher.refresh",
        "title": "Atualizar uso",
        "category": "Claude Switcher",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSwitcher.toggleAutoSwitch",
        "title": "Ligar/desligar o autoswitcher",
        "category": "Claude Switcher",
        "icon": "$(sync)"
      },
      {
        "command": "claudeSwitcher.memories.analyze",
        "title": "Analisar as memórias de novo",
        "category": "Claude Switcher",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSwitcher.memories.openClaudeMd",
        "title": "Abrir o CLAUDE.md global",
        "category": "Claude Switcher",
        "icon": "$(go-to-file)"
      },
      {
        "command": "claudeSwitcher.memories.merge",
        "title": "Juntar no CLAUDE.md global",
        "category": "Claude Switcher",
        "icon": "$(merge)"
      },
      {
        "command": "claudeSwitcher.memories.ignore",
        "title": "Ignorar",
        "category": "Claude Switcher",
        "icon": "$(close)"
      },
      {
        "command": "claudeSwitcher.memories.clearIgnored",
        "title": "Mostrar as sugestões ignoradas",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.memories.remove",
        "title": "Remover do CLAUDE.md",
        "category": "Claude Switcher",
        "icon": "$(trash)"
      },
      {
        "command": "claudeSwitcher.showAccounts",
        "title": "Contas",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.showAccountsCurrent",
        "title": "✓ Contas",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.showMemories",
        "title": "Memórias",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.showMemoriesCurrent",
        "title": "✓ Memórias",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.showCredentials",
        "title": "Credenciais",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.showCredentialsCurrent",
        "title": "✓ Credenciais",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.cred.create",
        "title": "Criar o cofre de credenciais",
        "category": "Claude Switcher",
        "icon": "$(add)"
      },
      {
        "command": "claudeSwitcher.cred.unlock",
        "title": "Destrancar as credenciais",
        "category": "Claude Switcher",
        "icon": "$(unlock)"
      },
      {
        "command": "claudeSwitcher.cred.lock",
        "title": "Trancar as credenciais",
        "category": "Claude Switcher",
        "icon": "$(lock)"
      },
      {
        "command": "claudeSwitcher.cred.import",
        "title": "Importar arquivo de credenciais",
        "category": "Claude Switcher",
        "icon": "$(desktop-download)"
      },
      {
        "command": "claudeSwitcher.cred.addEntry",
        "title": "Nova credencial",
        "category": "Claude Switcher",
        "icon": "$(add)"
      },
      {
        "command": "claudeSwitcher.cred.addField",
        "title": "Novo campo",
        "category": "Claude Switcher",
        "icon": "$(add)"
      },
      {
        "command": "claudeSwitcher.cred.editField",
        "title": "Trocar o valor",
        "category": "Claude Switcher",
        "icon": "$(edit)"
      },
      {
        "command": "claudeSwitcher.cred.renameEntry",
        "title": "Renomear",
        "category": "Claude Switcher",
        "icon": "$(edit)"
      },
      {
        "command": "claudeSwitcher.cred.renameField",
        "title": "Renomear o campo",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.cred.toggleSecret",
        "title": "Alternar secreto / não secreto",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.cred.removeEntry",
        "title": "Apagar a credencial",
        "category": "Claude Switcher",
        "icon": "$(trash)"
      },
      {
        "command": "claudeSwitcher.cred.removeField",
        "title": "Apagar o campo",
        "category": "Claude Switcher",
        "icon": "$(trash)"
      },
      {
        "command": "claudeSwitcher.cred.copy",
        "title": "Copiar o valor",
        "category": "Claude Switcher",
        "icon": "$(copy)"
      },
      {
        "command": "claudeSwitcher.cred.copyRef",
        "title": "Copiar a referência para o segredo",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.cred.changeMaster",
        "title": "Trocar a senha mestra",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.memories.addInstruction",
        "title": "Nova instrução no CLAUDE.md",
        "category": "Claude Switcher",
        "icon": "$(add)"
      },
      {
        "command": "claudeSwitcher.cred.reveal",
        "title": "Mostrar o valor",
        "category": "Claude Switcher",
        "icon": "$(eye)"
      },
      {
        "command": "claudeSwitcher.cred.hide",
        "title": "Esconder o valor",
        "category": "Claude Switcher",
        "icon": "$(eye-closed)"
      }
    ],
    "configuration": {
      "title": "Claude Switcher",
      "properties": {
        "claudeSwitcher.pollIntervalMinutes": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "De quantos em quantos minutos consultar o uso da conta em uso. As outras contas são consultadas a cada 15 minutos e na hora em que o limite delas zera."
        },
        "claudeSwitcher.autoSwitch": {
          "type": "boolean",
          "default": false,
          "description": "Autoswitcher: quando a conta em uso esgota, troca sozinho para a próxima disponível e faz o Claude Code continuar a tarefa, sem precisar digitar \"continue\". Instala um hook StopFailure em ~/.claude/settings.json (precisa do Node.js) e o remove ao desligar."
        },
        "claudeSwitcher.switchAtPercent": {
          "type": "number",
          "default": 99,
          "minimum": 50,
          "maximum": 100,
          "description": "Com o autoswitcher ligado, troca de conta no fim de uma resposta quando a conta em uso chega a esta % do limite de 5h ou da semana. Assim a próxima mensagem já vai pela conta nova, em vez de ser cortada no limite. 100 desliga essa troca antecipada e ele só troca quando a conta esgota."
        },
        "claudeSwitcher.maxWaitMinutes": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Tempo máximo, em minutos, que você aceita ficar sem poder usar o Claude de uma vez. A previsão escolhe a conta e sugere pausas para nenhuma espera passar disso, e avisa quando as contas não aguentam o seu ritmo."
        },
        "claudeSwitcher.notifyPace": {
          "type": "boolean",
          "default": true,
          "description": "Avisar pela previsão: quando todas as contas estão para esgotar, quando é hora de uma pausa e quando as contas não aguentam o seu ritmo."
        },
        "claudeSwitcher.notifyWhenBack": {
          "type": "boolean",
          "default": true,
          "description": "Avisar quando uma conta esgotada voltar a ficar disponível."
        },
        "claudeSwitcher.burnWindowHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "description": "Marca a conta com 🔥 (e avisa) quando faltam até estas horas para a semana dela renovar e ainda sobra uso. Também marca antes disso quando sobra mais do que dá para gastar até a renovação."
        },
        "claudeSwitcher.notifyBurn": {
          "type": "boolean",
          "default": true,
          "description": "Avisar quando a conta recomendada não é a que está em uso e tem uso prestes a vencer."
        },
        "claudeSwitcher.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar a conta em uso também na barra de status (lado esquerdo)."
        },
        "claudeSwitcher.credentials.lockMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 720,
          "description": "Por quantos minutos o cofre de credenciais fica destrancado depois da senha mestra. Depois disso ele tranca sozinho, em todas as janelas."
        }
      }
    }
  }
}
